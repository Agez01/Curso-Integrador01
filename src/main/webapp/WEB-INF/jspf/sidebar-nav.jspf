<%@ page pageEncoding="UTF-8" %>
<c:set var="rolActual" value="${sessionScope.usuario.rol.etiqueta}"/>
<nav>
  <a class="nav-item ${menu eq 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/dashboard"><span class="ic">◆</span> Dashboard Principal</a>
  <c:if test="${rolActual eq 'Administrador' or rolActual eq 'Almacenero'}">
    <a class="nav-item ${menu eq 'catalogo' ? 'active' : ''}" href="${pageContext.request.contextPath}/productos"><span class="ic">▤</span> Catálogo e Inventario</a>
  </c:if>
  <c:if test="${rolActual eq 'Cajero'}">
    <a class="nav-item ${menu eq 'ventas' ? 'active' : ''}" href="${pageContext.request.contextPath}/venta"><span class="ic">₪</span> Punto de Venta</a>
  </c:if>
  <c:if test="${rolActual eq 'Administrador' or rolActual eq 'Cajero'}">
    <a class="nav-item ${menu eq 'clientes' ? 'active' : ''}" href="${pageContext.request.contextPath}/clientes"><span class="ic">☺</span> Clientes</a>
  </c:if>
  <c:if test="${rolActual eq 'Administrador'}">
    <a class="nav-item ${menu eq 'usuarios' ? 'active' : ''}" href="${pageContext.request.contextPath}/usuarios"><span class="ic">⚙</span> Usuarios y roles</a>
  </c:if>
  <c:if test="${rolActual eq 'Almacenero'}">
    <a class="nav-item ${menu eq 'recepcion'  ? 'active' : ''}" href="${pageContext.request.contextPath}/entrada"><span class="ic">▣</span> Recepción de Mercadería</a>
  </c:if>
  <c:if test="${rolActual eq 'Administrador' or rolActual eq 'Almacenero'}">
    <a class="nav-item ${menu eq 'ajuste' ? 'active' : ''}" href="${pageContext.request.contextPath}/ajuste"><span class="ic">⇄</span> Ajuste de existencias</a>
    <a class="nav-item ${menu eq 'kardex' ? 'active' : ''}" href="${pageContext.request.contextPath}/kardex"><span class="ic">≡</span> Kardex y Reportes</a>
  </c:if>
</nav>
<div class="nav-foot">Almacén · PostgreSQL<br>Sesión: <c:out value="${sessionScope.usuario.nombre}"/> · <a class="nav-logout" href="${pageContext.request.contextPath}/logout">Cerrar sesión</a></div>
