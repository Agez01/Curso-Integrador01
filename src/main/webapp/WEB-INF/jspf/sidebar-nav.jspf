<%@ page pageEncoding="UTF-8" %>
<nav>
  <a class="nav-item ${pageContext.request.servletPath eq '/dashboard.jsp' ? 'active' : ''}" href="${pageContext.request.contextPath}/dashboard.jsp"><span class="ic">◆</span> Dashboard Principal</a>
  <c:if test="${sessionScope.usuario.rol.etiqueta eq 'Administrador' or sessionScope.usuario.rol.etiqueta eq 'Almacenero'}">
    <a class="nav-item ${pageContext.request.servletPath eq '/Pages/catalogo.jsp' ? 'active' : ''}" href="${pageContext.request.contextPath}/Pages/catalogo.jsp"><span class="ic">▤</span> Catálogo e Inventario</a>
  </c:if>
  <c:if test="${sessionScope.usuario.rol.etiqueta eq 'Administrador' or sessionScope.usuario.rol.etiqueta eq 'Cajero'}">
    <a class="nav-item ${pageContext.request.servletPath eq '/Pages/ventas.jsp' ? 'active' : ''}" href="${pageContext.request.contextPath}/Pages/ventas.jsp"><span class="ic">₪</span> Punto de Venta</a>
  </c:if>
  <c:if test="${sessionScope.usuario.rol.etiqueta eq 'Administrador' or sessionScope.usuario.rol.etiqueta eq 'Almacenero'}">
    <a class="nav-item ${pageContext.request.servletPath eq '/Pages/recepcion.jsp' ? 'active' : ''}" href="${pageContext.request.contextPath}/Pages/recepcion.jsp"><span class="ic">▣</span> Recepción de Mercadería</a>
    <a class="nav-item ${pageContext.request.servletPath eq '/kardex' ? 'active' : ''}" href="${pageContext.request.contextPath}/kardex"><span class="ic">≡</span> Kardex y Reportes</a>
  </c:if>
</nav>
<div class="nav-foot">Almacén · datos en memoria<br>Sesión: <c:out value="${sessionScope.usuario.nombre}"/> · <a class="nav-logout" href="${pageContext.request.contextPath}/logout">Cerrar sesión</a></div>
